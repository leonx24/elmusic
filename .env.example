# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Prefix for text commands (optional, default: !)
PREFIX=!

# Spotify API Configuration (Optional, for Spotify-first search resolution & metadata)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Cookies (Optional, export from browser as Netscape cookies.txt to bypass bot blocks)
YOUTUBE_COOKIES=

# Visuals & Color (Hex format)
EMBED_COLOR=#5865F2
