# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here

# Lavalink Node Configuration
# You can add multiple nodes separated by commas or duplicate config if needed.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASS=youshallnotpass
LAVALINK_SECURE=false

# YouTube OAuth Configuration (Helps bypass 'login required' blocks)
YOUTUBE_REFRESH_TOKEN=

# YouTube Proof-of-Origin Token (PO Token) & Visitor Data (Helps bypass SABR / bot detection on WEB client)
YOUTUBE_POT_TOKEN=
YOUTUBE_POT_VISITOR_DATA=

# Visuals & Color (Hex format)
EMBED_COLOR=#5865F2
